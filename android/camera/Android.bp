package {
    default_applicable_licenses: ["droidloom_license"],
}

cc_library_headers {
    name: "droidloom_camera_yuv_headers",
    vendor_available: true,
    export_include_dirs: ["include"],
    visibility: ["//hardware/interfaces/camera/device/default:__pkg__"],
}

// Android 17's camera client lists this compatibility shim as a shared
// dependency, although the Droidloom system image already supplies the API
// implementation in lib-camera-compatibility-info-api. Keep the native link
// closure explicit for the rebuilt cameraserver.
cc_library_shared {
    name: "libcameracompatbilityinfo",
    srcs: ["camera_compat_stub.cpp", "aidl/android/content/res/CameraCompatibilityInfo.aidl"],
    aidl: {
        local_include_dirs: ["aidl"],
        export_aidl_headers: true,
    },
    vendor: true,
}
